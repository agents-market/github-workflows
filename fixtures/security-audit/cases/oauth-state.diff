 import { createOAuth2Client } from '../vendor/google';
  
+const ALLOWED_REDIRECT_HOSTS = ['app.example.com'];
+
+function redirectUri(): string {
+  const base = process.env.APP_BASE_URL;
+  if (!base) return 'https://app.example.com/auth/google/callback';
+  const url = new URL(base);
+  if (url.protocol !== 'https:' || !ALLOWED_REDIRECT_HOSTS.includes(url.host)) {
+    throw new Error('APP_BASE_URL is not an allowed redirect target');
+  }
+  return `${url.origin}/auth/google/callback`;
+}
+
  export const oauth2Client = createOAuth2Client({
    clientId: process.env.GOOGLE_CLIENT_ID,
    clientSecret: process.env.GOOGLE_CLIENT_SECRET,
-  redirectUri: 'https://app.example.com/auth/google/callback',
+  redirectUri: redirectUri(),
    scopes: ['openid', 'email', 'profile'],
  });
  
-export async function fetchGoogleProfile(ticket: { payload: Record<string, string> }) {
-  const email = ticket.payload['email'];
-  return { email, name: ticket.payload['name'] ?? '' };
+export async function fetchGoogleProfile(tokens: { id_token: string }) {
+  const ticket = await oauth2Client.verifyIdToken({ idToken: tokens.id_token });
+  const payload = ticket.payload;
+  if (payload['iss'] !== 'https://accounts.google.com') {
+    throw new Error('unexpected token issuer');
+  }
+  if (payload['aud'] !== process.env.GOOGLE_CLIENT_ID) {
+    throw new Error('unexpected token audience');
+  }
+  const email = payload['email'];
+  if (!email) throw new Error('the token carries no email');
+  return {
+    email,
+    name: payload['name'] ?? '',
+    emailVerified: payload['email_verified'] === true,
+  };
  }
