+source wallet.
+
diff --git a/src/wallet/balance.ts b/src/wallet/balance.ts
index e69de29..caab375 100644
--- a/src/wallet/balance.ts
+++ b/src/wallet/balance.ts
@@ -0,0 +1,8 @@
+import { sql } from '../db';
+
+export async function walletBalance(userId: string, walletId: string) {
+  const rows = await sql`
+    select balance from wallets where id = ${walletId} and owner_id = ${userId}
+  `;
+  return rows[0]?.balance ?? 0n;
+}
