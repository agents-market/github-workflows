diff --git a/src/wallet/transfer.ts b/src/wallet/transfer.ts
index e69de29..5c0ccb8 100644
--- a/src/wallet/transfer.ts
+++ b/src/wallet/transfer.ts
@@ -0,0 +1,25 @@
+import { db } from '../db';
+import { ledger } from '../ledger';
+import { auditTrail } from '../audit';
+
+export async function transferFunds(userId: string, walletId: string, to: string, amount: bigint) {
+  if (amount <= 0n) throw new InvalidAmountError();
+
+  const wallet = await db.wallet.findUnique({ where: { id: walletId } });
+  if (!wallet || wallet.ownerId !== userId) {
+    throw new ForbiddenError('not your wallet');
+  }
+
+  await auditTrail.record({
+    event: 'wallet.transfer.requested',
+    walletId,
+    actor: userId,
+    amount: amount.toString(),
+  });
+
+  await ledger.transaction(async (tx) => {
+    const debited = await tx.debitIfEnough(walletId, amount);
+    if (!debited) throw new InsufficientFundsError();
+    await tx.credit(to, amount);
+  });
+}
