@@ -0,0 +1,15 @@
+import { sql } from '../db';
+import { sessionIdFromRequest } from '../auth/session';
+
+export async function requireRole(req: Request, role: string) {
+  const sessionId = sessionIdFromRequest(req);
+  if (!sessionId) throw new Response('forbidden', { status: 403 });
+
+  const rows = await sql`
+    select role from sessions where id = ${sessionId} and expires_at > now()
+  `;
+  const found = rows[0]?.role;
+  if (found !== role) {
+    throw new Response('forbidden', { status: 403 });
+  }
+}
