@@ -0,0 +1,11 @@
+export const UPSTREAM_URL = 'https://upstream.example.com';
+
+export function serviceKey(): string {
+  const key = process.env.UPSTREAM_SERVICE_KEY;
+  if (!key) throw new Error('UPSTREAM_SERVICE_KEY is not set');
+  return key;
+}
+
+export function isServiceKeyConfigured(): boolean {
+  return Boolean(process.env.UPSTREAM_SERVICE_KEY);
+}
