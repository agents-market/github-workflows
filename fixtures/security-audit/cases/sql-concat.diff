-export async function listReports(limit: number) {
-  const rows = await sql`select id, title from reports order by id limit ${limit}`;
+const MAX_PAGE = 200;
+
+export async function listReports(req: Request) {
+  const owner = await currentUser(req);
+  const rows = await sql`
+    select id, title from reports
+    where owner_id = ${owner.id} and visible = true
+    order by id limit ${MAX_PAGE}
+  `;
+  return rows;
+}
+
+export async function countVisibleReports(req: Request) {
+  const owner = await currentUser(req);
+  const rows = await sql`
+    select count(*) as n from reports where owner_id = ${owner.id} and visible = true
+  `;
+  return Number(rows[0]?.n ?? 0);
  }
